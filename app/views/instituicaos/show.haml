.card.status.borda
  .titulo
    %i.bi.bi-bank.afastado
    = @instituicao.nome

- if @instituicao.mantenedora
  .card.center.borda
    #title{style:"font-size:15px"}
      %i.bi.bi-briefcase-fill
      = link_to_mantenedora @instituicao.mantenedora

.center{style: "padding-bottom:10px"}
  - if @instituicao.sigla
    .badge.bg-light.text-dark= @instituicao.sigla
  - if @instituicao.categoria
    .badge.bg-info= @instituicao.categoria
  - if @instituicao.liberada_at
    .badge.bg-success= "Desde #{@instituicao.liberada_at.year}"

- if @instituicao.site.present?
  .center
    %a{href: @instituicao.site, target: "_blank"}= @instituicao.site

- if @instituicao.cursos.any?
  %table.table.table-striped.borda
    %thead
      %tr
        %th{style:'text-align:left'} Curso
    %tbody
      - @instituicao.cursos.uniq.each do |curso|
        %tr
          %td{style:'text-align:left'}= link_to_curso curso
