.card.status.borda
  .titulo
    %i.bi.bi-mortarboard-fill.afastado
    = @curso.nome

.center{style: "padding-bottom:10px"}
  .badge.bg-light.text-dark= "#{@curso.instituicaos.count} instituições"
  - if primeiro = @curso.primeiro_em
    .badge.bg-success= "Desde #{primeiro.liberado_at}"

- if @curso.instituicaos.any?
  %table.table.table-striped.borda
    %thead
      %tr
        %th{style:'text-align:left'} Instituição
        %th Categoria
        %th Desde
    %tbody
      - @curso.instituicaos.each do |instituicao|
        %tr
          %td{style:'text-align:left'}= link_to_instituicao instituicao
          %td= instituicao.categoria
          %td= instituicao.liberada_at ? instituicao.liberada_at.year : "-"
