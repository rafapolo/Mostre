.card.status.borda
  .titulo
    %i.bi.bi-building.afastado
    = @mantenedora.nome

.center{style: "padding-bottom:10px"}
  .badge.bg-light.text-dark= "Cod. MEC #{@mantenedora.cod_mec}"
  - if @mantenedora.natureza
    .badge.bg-info= @mantenedora.natureza
  .badge.bg-success= "#{@mantenedora.instituicaos.count} instituições"

- if @mantenedora.representante
  .card.center.borda
    #title{style:"font-size:15px"}
      %i.bi.bi-person-fill
      = @mantenedora.representante

- if @mantenedora.instituicaos.any?
  %table.table.table-striped.borda
    %thead
      %tr
        %th{style:'text-align:left'} Instituição
        %th Sigla
        %th Cursos
    %tbody
      - @mantenedora.instituicaos.each do |instituicao|
        %tr
          %td{style:'text-align:left'}= link_to_instituicao instituicao
          %td= instituicao.sigla
          %td= instituicao.cursos.count
